# Copy this file to .env and fill in your own values. Never commit .env.
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=your-bot-token-here
# Application (client) ID, shown on the "General Information" page
DISCORD_CLIENT_ID=your-application-id
# Optional: a test server ID. If set, commands deploy instantly to that server only.
DISCORD_GUILD_ID=
